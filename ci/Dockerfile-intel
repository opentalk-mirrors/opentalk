FROM intel/oneapi-basekit AS builder

ARG WHISPER_CPP_TAG=v1.8.0

RUN apt-get update
RUN apt-get install -y --no-install-recommends \
      intel-media-va-driver intel-gpu-tools \
      build-essential \
      pkg-config \
      libglib2.0-dev \
      libssl-dev \
      curl \
      clang \
      libomp-dev \
      intel-oneapi-mkl-devel intel-oneapi-mkl \
      clinfo \
      git \
      libvulkan-dev glslc

RUN curl -O https://repo.heinlein.group/repository/whisper-ggml-models/ggml-large-v3-turbo.bin
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable

ENV PATH=${PATH}:/root/.cargo/bin

RUN git clone --branch ${WHISPER_CPP_TAG} --depth 1 https://github.com/ggml-org/whisper.cpp /whisper.cpp
WORKDIR /whisper.cpp

RUN mkdir -p build
WORKDIR /whisper.cpp/build

RUN cmake .. \
    -DGGML_SYCL=ON \
    -DGGML_SYCL_TARGET=INTEL \
    -DCMAKE_C_COMPILER=icx \
    -DCMAKE_CXX_COMPILER=icpx \
    -DCMAKE_BUILD_TYPE=Release

# Actual build job
RUN cmake --build .

WORKDIR /app

COPY Cargo.toml Cargo.toml
COPY Cargo.lock Cargo.lock
COPY opentalk-transcription opentalk-transcription
COPY opentalk-transcription-web-api opentalk-transcription-web-api

RUN cargo build --locked --release --features sycl

############## Runtime container ##############
FROM intel/oneapi-basekit

ENV USERID=1000
ENV GROUPID=1000

RUN apt-get --update full-upgrade -y && apt-get install -y --no-install-recommends \
    clinfo \
    intel-media-va-driver intel-gpu-tools \
    intel-oneapi-mkl \
    libvulkan1 && \
    groupadd --gid $GROUPID transcription 2> /dev/null || true && \
    useradd --uid $USERID --gid $GROUPID --create-home transcription 2> /dev/null || true && \
    mkdir /transcription

WORKDIR /transcription

RUN mkdir -p /opt/whisper.cpp/lib

COPY --from=builder /whisper.cpp/build/ggml/src/* /opt/whisper.cpp/lib/
COPY --from=builder /whisper.cpp/build/src/libwhisper.so* /opt/whisper.cpp/lib/

ENV MKLROOT=/opt/intel/oneapi/mkl/2025.2
ENV ONEAPI_DEVICE_SELECTOR="level_zero:0"
ENV RUST_LOG="opentalk=debug,whisper_rs=warn,info"
ENV LD_LIBRARY_PATH=/opt/whisper.cpp/lib:${MKLROOT}/lib:${LD_LIBRARY_PATH}

COPY --from=builder /app/target/release/opentalk-transcription .
COPY --from=builder /ggml-large-v3-turbo.bin models/.
COPY extra/example.toml transcription.toml

USER $USERID:$GROUPID

EXPOSE 11413
EXPOSE 11412

ENTRYPOINT [ "./opentalk-transcription" ]
