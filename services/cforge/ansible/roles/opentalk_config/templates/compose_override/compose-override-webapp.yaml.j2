{% if Deployment.environment is defined and 'dev' in Deployment.environment %}
services:
  webapp:
    extra_hosts:
      - "keycloak.localhost:host-gateway"  
    ports: !override
      - ${OT_FRONTEND_EXP_PORT:-8081}:80
    environment:
      INSECURE: true
      CONTROLLER_HOST: ${OT_DOMAIN}/controller
      BASE_URL: http://${OT_DOMAIN}
      OIDC_ISSUER: http://${OT_DOMAIN}/auth/realms/opentalk
      OIDC_CLIENT_ID: Webapp
      LIVEKIT_SERVER_URL: http://${OT_DOMAIN}/livekit
      NDT_SERVER: ${NDT_SERVER:-ndt.example.com}
      CHANGE_PASSWORD_URL: http://${OT_DOMAIN}/auth/realms/opentalk/account/
    labels: !override
      - "traefik.enable=true"
      - "traefik.http.routers.webapp.rule=Host(`localhost`)"
      - "traefik.http.routers.webapp.priority=10"
      - "traefik.http.routers.webapp.entrypoints=web"
      - "traefik.http.services.webapp.loadbalancer.server.port=80"
      - "traefik.http.routers.webapp-callback.rule=Host(`localhost`) && Path(`/auth/callback`)"
      - "traefik.http.routers.webapp-callback.priority=100"
      - "traefik.http.routers.webapp-callback.entrypoints=web"
      - "traefik.http.routers.webapp-callback.middlewares=webapp-cors"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowMethods=GET,POST,PUT,DELETE,OPTIONS"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowOriginList=http://localhost,http://*.localhost"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowCredentials=true"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowHeaders=Content-Type,Authorization"
{% else %}
services:
  webapp:
{% endif %}