{% if Deployment.environment is defined and 'dev' in Deployment.environment %}
services:
  mailcrab:
    profiles: ["standard", "mailcrab"]
    labels: !override
      - "traefik.enable=true"
      - "traefik.http.routers.mailcrab.rule=Host(`localhost`) && PathPrefix(`/adm/mailcrab`)"
      - "traefik.http.routers.mailcrab.entrypoints=web"
      - "traefik.http.routers.mailcrab.middlewares=mailcrab-strip"
      - "traefik.http.middlewares.mailcrab-strip.stripprefix.prefixes=/adm/mailcrab"
      - "traefik.http.services.mailcrab.loadbalancer.server.port=1080"
{% else %}
services:
  mailcrab:
{% if CustomCertificates.enabled is defined and CustomCertificates.enabled is true %}
    labels: !override
      - "traefik.enable=true"
      - "traefik.http.routers.mailcrab.rule=Host(`${OT_DOMAIN}`) && PathPrefix(`/adm/mailcrab`)"
      - "traefik.http.routers.mailcrab.entrypoints=websecure"
      - "traefik.http.routers.mailcrab.middlewares=mailcrab-strip, default-auth@file"
      - "traefik.http.middlewares.mailcrab-strip.stripprefix.prefixes=/adm/mailcrab"
      - "traefik.http.services.mailcrab.loadbalancer.server.port=1080"
{% endif %}
{% endif %}