# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

[rabbit_mq]
url = "{{ Mailer.rabbit_mq.url }}"
mail_task_queue = "{{ Mailer.rabbit_mq.mail_task_queue }}"

[smtp]
smtp_server = "{{ Mailer.smtp.smtp_server }}"
from_name = "{{ Mailer.smtp.from_name }}"
from_email = "{{ Mailer.smtp.from_email }}"

[template_builder]
{% if Mailer.template_builder.join_link_builder is defined and Mailer.template_builder.join_link_builder %}
join_link_builder = "{{ Mailer.template_builder.join_link_builder }}"
{% endif %}
{% if Mailer.template_builder.guest_link_builder is defined and Mailer.template_builder.guest_link_builder %}
guest_link_builder = "{{ Mailer.template_builder.guest_link_builder }}"
{% endif %}
{% if Mailer.template_builder.dashboard_event_link_builder is defined and Mailer.template_builder.dashboard_event_link_builder %}
dashboard_event_link_builder = "{{ Mailer.template_builder.dashboard_event_link_builder }}"

{% endif %}
[templates]
{% if Mailer.templates.registered_invite is defined and Mailer.templates.registered_invite %}
registered_invite = {{ Mailer.templates.registered_invite }}
{% endif %}
{% if Mailer.templates.unregistered_invite is defined and Mailer.templates.unregistered_invite %}
unregistered_invite = {{ Mailer.templates.unregistered_invite }}
{% endif %}
{% if Mailer.templates.external_invite is defined and Mailer.templates.external_invite %}
external_invite = {{ Mailer.templates.external_invite }}
{% endif %}
{% if Mailer.templates.registered_event_update is defined and Mailer.templates.registered_event_update %}
registered_event_update = {{ Mailer.templates.registered_event_update }}
{% endif %}
{% if Mailer.templates.unregistered_event_update is defined and Mailer.templates.unregistered_event_update %}
unregistered_event_update  = {{ Mailer.templates.unregistered_event_update }}
{% endif %}
{% if Mailer.templates.external_event_update is defined and Mailer.templates.external_event_update %}
external_event_update = {{ Mailer.templates.external_event_update }}
{% endif %}
{% if Mailer.templates.registered_event_cancellation is defined and Mailer.templates.registered_event_cancellation %}
registered_event_cancellation = {{ Mailer.templates.registered_event_cancellation }}
{% endif %}
{% if Mailer.templates.unregistered_event_cancellation is defined and Mailer.templates.unregistered_event_cancellation %}
unregistered_event_cancellation = {{ Mailer.templates.unregistered_event_cancellation }}
{% endif %}
{% if Mailer.templates.external_event_cancellation is defined and Mailer.templates.external_event_cancellation %}
external_event_cancellation = {{ Mailer.templates.external_event_cancellation }}
{% endif %}
{% if Mailer.templates.registered_uninvite is defined and Mailer.templates.registered_uninvite %}
registered_uninvite = {{ Mailer.templates.registered_uninvite }}
{% endif %}
{% if Mailer.templates.unregistered_uninvite is defined and Mailer.templates.unregistered_uninvite %}
unregistered_uninvite = {{ Mailer.templates.unregistered_uninvite }}
{% endif %}
{% if Mailer.templates.external_uninvite is defined and Mailer.templates.external_uninvite %}
external_uninvite = {{ Mailer.templates.external_uninvite }}

{% endif %}
[frontend]
{% if Mailer.frontend.base_url is defined and Mailer.frontend.base_url %}
base_url = "{{ Mailer.frontend.base_url }}"
{% endif %}
{% if Mailer.frontend.data_protection_url is defined and Mailer.frontend.data_protection_url %}
data_protection_url = "{{ Mailer.frontend.data_protection_url }}"
{% endif %}

[languages]
default_language = "{{ Mailer.languages.default_language }}"

{% if Mailer.monitoring is defined and Mailer.monitoring %}
[monitoring]
{% if Mailer.monitoring.addr is defined and Mailer.monitoring.addr %}
addr = "{{ Mailer.monitoring.addr }}"
{% endif %}
{% if Mailer.monitoring.port is defined and Mailer.monitoring.port %}
port = {{ Mailer.monitoring.port }}
{% endif %}

{% endif %}
{% if Mailer.support_contact is defined and Mailer.support_contact %}
[support_contact]
{% if Mailer.support_contact.phone is defined and Mailer.support_contact.phone %}
phone = "{{ Mailer.support_contact.phone }}"
{% endif %}
{% if Mailer.support_contact.mail is defined and Mailer.support_contact.mail %}
mail = "{{ Mailer.support_contact.mail }}"
{% endif %}
{% endif %}