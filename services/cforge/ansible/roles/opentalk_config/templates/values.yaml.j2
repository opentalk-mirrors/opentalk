---
Keycloak:
  realm: {{ Keycloak.realm }}
  base_url: {{ Keycloak.base_url }}
  api_base_url: {{ Keycloak.api_base_url }}
  hostname: {{ Keycloak.hostname }}
  proxy: {{ Keycloak.proxy }}
  proxy_headers: {{ Keycloak.proxy_headers }}
  db:
    vendor: {{ Keycloak.db.vendor }}
    username: {{ Keycloak.db.username }}
    password: {{ KEYCLOAK_DB_PASSWORD }}
    schema: {{ Keycloak.db.schema }}
    url:
      database: {{ Keycloak.db.url.database }} 
      host: {{ Keycloak.db.url.database }}
      port: {{ Keycloak.db.url.database }}
  health_enabled: {{ Keycloak.health_enabled }}
  metrics_enabled: {{ Keycloak.metrics_enabled }}
  http:
    relative_path: {{ Keycloak.http.relative_path }}
  https:
    certificate_file: {{ Keycloak.https.certificate_file }}
    certificate_key_file: {{ Keycloak.https.certificate_key_file }}
  spi_sticky_session_encoder_infinispan_should_attach_route: {{ Keycloak.spi_sticky_session_encoder_infinispan_should_attach_route }}

Controller:
  logging:
    #default_directives:
    #  - "ERROR"
    #  - "opentalk=INFO"
    #  - "pinky_swear=OFF"
    #  - "rustls=WARN"
    #  - "mio=ERROR"
    #  - "lapin=WARN"
    #  - "execution_id=trace"
    #otlp_tracing_endpoint: "http://localhost:4317"
    #service_name: "controller"
    #service_namespace: "opentalk"
    #service_instance_id: "627cc493-f310-47de-96bd-71410b7dec09"
  database:
    name: controller
    user: ot
    host: controller-db
    port: 5435
    max_connections: 100
  http:
    port: 11311
  oidc:
    authority: {{ Global.keycloak.base_url }}
    frontend:
      # Optional, if not set, the value from `oidc.authority` is used.
      # authority: "https://example.com/auth/realms/OPENTALK"
      client_id: "Frontend"
    controller:
      # Optional, if not set, the value from `oidc.authority` is used.
      # authority: "https://example.com/auth/realms/OPENTALK"
      client_id: "Controller"
      client_secret: "v3rys3cr3t"
  user_search:
    backend: "keycloak_webapi"
    api_base_url: {{ Keycloak.url.base.admin_api_path | default('https://example.com/auth/admin/realms/OPENTALK') }}
    users_find_behavior: "from_user_search_backend"
  livekit:
    public_url: "wss://url.to.your.livekit.server"
    service_url: "https://localhost:7880"
    api_key: "your-livekit-api-key"
    api_secret: "your-livekit-api-secret"
  rabbit_mq:
    # url: "amqp://username:password@host/%2F"
    # mail_task_queue: "opentalk_mailer"
    # recording_task_queue: "opentalk_recorder"
    # min_connections: 10
    # max_channels_per_connection: 100
  minio:
    uri: "http://localhost:9555"
    bucket: "controller"
    access_key: "minioadmin"
    secret_key: "minioadmin"
  etcd:
    urls:
      - "localhost:2379"
