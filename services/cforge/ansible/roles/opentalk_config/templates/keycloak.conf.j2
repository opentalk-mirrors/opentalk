# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

bootstrap-admin-username=admin
bootstrap-admin-password={{ KC_BOOTSTRAP_ADMIN_PASSWORD }}

# Database

# The database vendor.
db=postgres

# The username of the database user.
db-username={{ Keycloak.db.username }}

# The password of the database user.
db-password={{ Keycloak.db.password }}

db-schema={{ Keycloak.db.schema }}

db-url-database={{ Keycloak.db.url.database }}
db-url-host={{ Keycloak.db.url.host }}
db-url-port={{ Keycloak.db.url.port }}

# Observability

# If the server should expose healthcheck endpoints.
health-enabled={{ Keycloak.health_enabled }}

# If the server should expose metrics endpoints.
metrics-enabled={{ Keycloak.metrics_enabled }}

# HTTP

http-enabled=true

http-relative-path={{ Keycloak.http.relative_path }}

{% if Deployment.environment is defined and 'dev' in Deployment.environment %}
hostname=http://keycloak.localhost:8000/auth
hostname-strict=false
proxy=edge
proxy-headers=xforwarded
hostname-backchannel-dynamic=true
{% else %}
# Hostname for the Keycloak server.
hostname={{ Keycloak.hostname }}
proxy-headers=xforwarded
{% endif %}
