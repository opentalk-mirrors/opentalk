# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.
---
version: {{ Minio.version }}
address: "{{ Minio.address }}"
rootUser: "{{ Minio.rootUser }}"
rootPassword: "{{ Minio.rootPassword }}"
console-address: "{{ Minio.console_address }}"
{% if Minio.certs_dir is defined and Minio.certs_dir %}
certs-dir: "{{ Minio.certs_dir }}"
{% endif %}
{% if Minio.pools is defined and Minio.pools %}
{% for pool in Minio.pools %}
    - args:
{% for arg in pool.args %}
        - "{{ arg }}"
{% endfor %}
{% endfor %}
{% endif %}
{% if Minio.options is defined and Minio.options %}
options:
{% if Minio.options.ftp is defined and Minio.options.ftp %}
  ftp:
    address: "{{ Minio.options.ftp.address }}"
    passive-port-range: "{{ Minio.options.ftp.passive_port_range }}"
{% endif %}
{% if Minio.options.sftp is defined and Minio.options.sftp %}
  sftp:
    address: "{{ Minio.options.sftp.address }}"
    ssh-private-key: "{{ Minio.options.sftp.ssh_private_key }}"
{% endif %}
{% endif %}