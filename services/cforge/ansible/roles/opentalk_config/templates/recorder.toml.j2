# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

[auth]
issuer = "{{ Recorder.auth.issuer }}"
client_id = "{{ Recorder.auth.client_id }}"
client_secret = "{{ Recorder.auth.client_secret }}"

[controller]
# host-port of the controller
domain = "{{ Recorder.controller.domain }}"

{% if Recorder.controller.insecure is defined and Recorder.controller.insecure %}
# Optional flag to use http/ws instead of their TLS counterparts
insecure = {{ Recorder.controller.insecure }}

{% endif %}
[rabbitmq]
uri = "{{ Recorder.rabbitmq.uri }}"
queue = "{{ Recorder.rabbitmq.queue }}"

[recorder]
display = {{ Recorder.recorder.display }}
clock_format = "{{ Recorder.recorder.clock_format }}"

{% if Recorder.recorder.hardware_acceleration is defined and Recorder.recorder.hardware_acceleration %}
[recorder.hardware_acceleration]
manufacturer = "{{ Recorder.recorder.hardware_acceleration.manufacturer }}"
device = "{{ Recorder.recorder.hardware_acceleration.device }}"

{% endif %}
{% if Recorder.monitoring is defined and Recorder.monitoring %}
[monitoring]
port = {{ Recorder.monitoring.port }}
{% endif %}
