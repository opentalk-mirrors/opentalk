# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.
---
port: {{ Livekit.port }}
rtc:
  tcp_port: {{ Livekit.rtc.tcp_port }}
  port_range_start: {{ Livekit.rtc.port_range_start }}
  port_range_end: {{ Livekit.rtc.port_range_end }}
  use_external_ip: {{ Livekit.rtc.use_external_ip }}
  enable_loopback_candidate: {{ Livekit.rtc.enable_loopback_candidate }}
{% if Livekit.stun_servers is defined and Livekit.stun_servers %}
{% for stun_server in Livekit.stun_servers %}
stun_servers: 
   - {{ stun_server }}
{% endfor %}
{% endif %}
{% if Livekit.turn_servers is defined and Livekit.turn_servers %}
{% for turn_server in Livekit.turn_servers %}
turn_servers: 
  - host: {{ turn_server.host }}
    port: {{ turn_server.port }}
    protocol: {{ turn_server.protocol }}
    username: {{ turn_server.username }}
    credential: {{ turn_server.credential }}
{% endfor %}
{% endif %}
{% if Livekit.turn_servers is defined and Livekit.turn_servers %}
prometheus_port: {{ Livekit.prometheus_port }}
{% endif %}

{% if Livekit.api_keys is defined and Livekit.api_keys %}
keys:
  controller: {{ Livekit.api_keys.controller }}
{% endif %}

{% if Livekit.logging is defined and Livekit.logging %}
logging:
  {% if Livekit.logging.json is defined and Livekit.logging.json %}
  json: {{ Livekit.logging.json }}
  {% endif %}
  {% if Livekit.logging.level is defined and Livekit.logging.level %}
  level: {{ Livekit.logging.level }}
  {% endif %}
{% endif %}

