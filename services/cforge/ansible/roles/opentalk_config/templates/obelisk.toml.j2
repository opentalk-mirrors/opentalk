# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

clock_format = "{{ Obelisk.clock_format }}"

[auth]
issuer = "{{ Obelisk.auth.issuer }}"
# OIDC client ID
client_id = "{{ Obelisk.auth.client_id }}"
# OIDC client secret
client_secret = "{{ Obelisk.auth.client_secret }}"

[controller]
# host-port of the controller
domain = "{{ Obelisk.controller.domain }}"

# Optional flag to use http/ws instead of their TLS counterparts
#insecure = {{ Obelisk.controller.insecure }}

[sip]
# Local IP address to bind to (0.0.0.0 binds to every address)
addr = "{{ Obelisk.sip.addr }}"

# Port to bind to (5060 is SIP default)
port = {{ Obelisk.sip.port }}

# ID of this SIP endpoint
# When not set, it is generated as sip:<username>@<addr> where `addr` may be replaced by the
# public address discovered using the stun-server
{% if Obelisk.sip.id is defined and Obelisk.sip.id %}
id = "{{ Obelisk.sip.id }}"
{% endif %}
{% if Obelisk.sip.contact is defined and Obelisk.sip.contact %}
contact = "{{ Obelisk.sip.contact }}"
{% endif %}
username = "{{ Obelisk.sip.username }}"
password = "{{ Obelisk.sip.password }}"
realm = "{{ Obelisk.sip.realm }}"
registrar = "{{ Obelisk.sip.registrar }}"
{% if Obelisk.sip.outbound_proxy is defined and Obelisk.sip.outbound_proxy %}
outbound_proxy = "{{ Obelisk.sip.outbound_proxy }}"
{% endif %}
{% if Obelisk.sip.nat_ping_delta is defined and Obelisk.sip.nat_ping_delta %}
nat_ping_delta = "{{ Obelisk.sip.nat_ping_delta }}"
{% endif %}
stun_server = "{{ Obelisk.sip.stun_server }}"
enforce_qop = {{ Obelisk.sip.enforce_qop }}
{% if Obelisk.sip.max_video_bitrate is defined and Obelisk.sip.max_video_bitrate %}
max_video_bitrate = "{{ Obelisk.sip.max_video_bitrate }}"
{% endif %}
{% if Obelisk.sip.offer_srtp is defined and Obelisk.sip.offer_srtp %}
offer_srtp = "{{ Obelisk.sip.offer_srtp }}"
{% endif %}

[sip.rtp_port_range]
start = {{ Obelisk.sip.rtp_port_range.start }}
end = {{ Obelisk.sip.rtp_port_range.end }}
{% if Obelisk.monitoring is defined and Obelisk.monitoring %}

[monitoring]
{% if Obelisk.monitoring.addr is defined and Obelisk.monitoring.addr %}
addr = "{{ Obelisk.monitoring.addr }}"
{% endif %}
{% if Obelisk.monitoring.port is defined and Obelisk.monitoring.port %}
port = {{ Obelisk.monitoring.port }}
{% endif %}
{% endif %}