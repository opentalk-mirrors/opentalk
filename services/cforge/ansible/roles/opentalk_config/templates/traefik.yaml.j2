# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

# replace
#### https://github.com/traefik/traefik/issues/5853#issuecomment-2053572387

global:
  checkNewVersion: true
  sendAnonymousUsage: false

#experimental:
#  plugins:
#    keycloakopenid:
#      moduleName: "github.com/Gwojda/keycloakopenid"
#      version: "v0.1.35"
#    traefik-oidc-auth:
#      moduleName: "github.com/sevensolutions/traefik-oidc-auth"
#      version: "v0.4.1"

# Log settings
log:
  level: {{ Traefik.log.log_level }}

accessLog:
  bufferingSize: 100

api:
  dashboard: true
  insecure: {{ Traefik.api.insecure }}

entryPoints:
  web:
    address: ":80"
  websecure:
    address: ":443"
{% if CustomCertificates.enabled is defined and CustomCertificates.enabled is true %}
    http:
      tls: {}
{% endif %}
  ping:
    address: ":8082"

ping:
  entryPoint: "ping"

{% if Deployment.environment is not defined or 'dev' not in Deployment.environment %}
{% if CustomCertificates.enabled is not defined or not CustomCertificates.enabled %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: ops@{{ OT_DOMAIN }}
      storage: /data/acme.json
      #caServer: https://acme-staging-v02.api.letsencrypt.org/directory
      httpChallenge:
        entryPoint: web
{% endif %}
{% endif %}

providers:
  docker:
    exposedByDefault: false
  file:
    directory: /etc/traefik/dynamic
    watch: true