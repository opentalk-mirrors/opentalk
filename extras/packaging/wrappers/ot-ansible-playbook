#!/usr/bin/env bash
set -euo pipefail
# Wrapper with self-heal and container fallback.

PREFIX="/opt/opentalk-compose"
BIN="$PREFIX/.venv/bin/ansible-playbook"
POSTINST="$PREFIX/extras/packaging/pkg-postinst.sh"

if [ ! -x "$BIN" ] && [ -x "$POSTINST" ]; then
  echo "[wrapper] Attempting self-heal (rebuild venv)..." >&2
  bash "$POSTINST" || true
fi

export ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-$PREFIX/ansible.cfg}"
export ANSIBLE_COLLECTIONS_PATHS="${ANSIBLE_COLLECTIONS_PATHS:-$PREFIX/vendor/collections}"
export PYTHONDONTWRITEBYTECODE=1

if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi

echo "[wrapper] Embedded Ansible missing. Falling back to container..." >&2
exec docker compose -f "$PREFIX/services/cforge/compose.yaml" run --rm cforge ansible-playbook "$@"