# The container images under container/ are runtime-only: they consume the binaries
# produced by the `build` job of .gitlab-ci.yml plus a handful of data files. Only
# include files referenced by `COPY` commands.

/target
/container
/LICENSES

# Include binaries produced by the `build` job in .gitlab-ci.yml
!target/release/opentalk-controller
!target/release/opentalk-obelisk
!target/release/opentalk-orchestrator
!target/release/opentalk-recorder
!target/release/opentalk-roomserver
!target/release/opentalk-smtp-mailer
!target/release/opentalk-transcription

# Include other files copied into the images
!controller/example/controller.toml
!smtp-mailer/resources
!smtp-mailer/resources/**
!transcription/extra/example.toml
