# Mandatory configuration option
# OT_DOMAIN must be set for opentalk to function correctly.
OT_DOMAIN="${OT_DOMAIN:-localhost:8080}"

COMPOSE_PROJECT_NAME=opentalk

# Avialable profiles: full,standard,core
COMPOSE_PROFILES=standard

### cforge behavior

FORCE_CONFIG=true
# ENABLE_CFORGE=true
# FORCE_SECRETS=false

COMPOSE_FILE=compose.yaml${KEYCLOAK_COMPOSE_OVERRIDE:-}${LIVEKIT_COMPOSE_OVERRIDE:-}${MAILCRAB_COMPOSE_OVERRIDE:-}${MINIO_COMPOSE_OVERRIDE:-}${POSTGRES_COMPOSE_OVERRIDE:-}${RABBITMQ_COMPOSE_OVERRIDE:-}${TRAEFIK_COMPOSE_OVERRIDE:-}${CFORGE_COMPOSE_OVERRIDE:-}${CONTROLLER_COMPOSE_OVERRIDE:-}${ETHERPAD_COMPOSE_OVERRIDE:-}${MAILER_COMPOSE_OVERRIDE:-}${RECORDER_COMPOSE_OVERRIDE:-}${SPACEDECK_COMPOSE_OVERRIDE:-}${WEBAPP_COMPOSE_OVERRIDE:-}