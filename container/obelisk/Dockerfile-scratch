FROM ubuntu:resolute AS preparer

RUN apt-get --update full-upgrade -y && \
    apt-get install libssl3 ca-certificates -y --no-install-recommends && \
    update-ca-certificates

FROM scratch

COPY --from=preparer /lib64/ld-linux-x86-64* /lib64/
COPY --from=preparer /usr/bin/ld.so /lib/
COPY --from=preparer /usr/lib /usr/lib
COPY --from=preparer /etc/nsswitch.conf /etc/nsswitch.conf
COPY --from=preparer /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

ENV LD_LIBRARY_PATH=/usr/lib:/lib:/lib64
ENV PATH=/:/usr/bin/

ENV USERID=1000
ENV GROUPID=1000

WORKDIR /obelisk

COPY target/release/opentalk-obelisk .

USER $USERID:$GROUPID

ENTRYPOINT [ "/obelisk/opentalk-obelisk" ]
