FROM git.opentalk.dev:5050/opentalk/backend/containers/gstreamer:1.26-intel AS preparer

RUN apt-get update && apt-get full-upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends libssl3 \
    intel-media-va-driver \
    libopenh264-8 ca-certificates \
    tzdata \
    fonts-terminus ttf-bitstream-vera fonts-liberation fonts-noto \
    libcap2-bin && \
    # intel-gpu-tools pulls in fontconfig-config as a transitive dependency which brings a
    # new configuration file for /etc/fonts/fonts.conf.
    apt-get -o Dpkg::Options::="--force-confnew" install -y --no-install-recommends intel-gpu-tools && \
    setcap cap_perfmon=+ep $(which intel_gpu_top) && fc-cache -fv

RUN mkdir -m 1755 /my_tmp

FROM scratch

COPY --from=preparer /my_tmp /tmp
COPY --from=preparer /lib64/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2
COPY --from=preparer /usr/bin/intel_gpu_top /usr/bin/intel_gpu_top
COPY --from=preparer /usr/bin/ld.so /lib/ld.so
COPY --from=preparer /usr/lib /usr/lib
COPY --from=preparer /lib /lib
COPY --from=preparer /etc/fonts/fonts.conf /etc/fonts/fonts.conf
COPY --from=preparer /etc/nsswitch.conf /etc/nsswitch.conf
COPY --from=preparer /usr/bin/gst-inspect-1.0 /usr/bin/gst-inspect-1.0
COPY --from=preparer /usr/libexec/gstreamer-1.0 /usr/libexec/gstreamer-1.0
COPY --from=preparer /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=preparer /usr/share/zoneinfo /usr/share/zoneinfo

COPY target/release/opentalk-recorder /opentalk-recorder

ENV LD_LIBRARY_PATH=/usr/lib:/lib
ENV GST_DEBUG_DUMP_DOT_DIR=/tmp
ENV PATH=/:/usr/bin/

ENTRYPOINT [ "/opentalk-recorder" ]
