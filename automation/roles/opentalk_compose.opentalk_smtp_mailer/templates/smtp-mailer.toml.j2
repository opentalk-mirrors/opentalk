# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

[rabbit_mq]
url = "{{ mailer_rabbit_mq_url }}"
mail_task_queue = "{{ mailer_rabbit_mq_mail_task_queue }}"
{% if mailer_rabbit_mq_task_processing_timeout_seconds is defined %}
task_processing_timeout_seconds = {{ mailer_rabbit_mq_task_processing_timeout_seconds }}
{% endif %}

[smtp]
smtp_server = "{{ mailer_smtp_smtp_server }}"
from_name = "{{ mailer_smtp_from_name }}"
from_email = "{{ mailer_smtp_from_email }}"

[template_builder]
{% if mailer_template_builder_join_link_builder is defined and mailer_template_builder_join_link_builder %}
join_link_builder = "{{ mailer_template_builder_join_link_builder }}"
{% endif %}
{% if mailer_template_builder_guest_link_builder is defined and mailer_template_builder_guest_link_builder %}
guest_link_builder = "{{ mailer_template_builder_guest_link_builder }}"
{% endif %}
{% if mailer_template_builder_dashboard_event_link_builder is defined and mailer_template_builder_dashboard_event_link_builder %}
dashboard_event_link_builder = "{{ mailer_template_builder_dashboard_event_link_builder }}"
{% endif %}

[templates]
{% if mailer_templates_registered_invite is defined and mailer_templates_registered_invite %}
registered_invite = {{ mailer_templates_registered_invite }}
{% endif %}
{% if mailer_templates_unregistered_invite is defined and mailer_templates_unregistered_invite %}
unregistered_invite = {{ mailer_templates_unregistered_invite }}
{% endif %}
{% if mailer_templates_external_invite is defined and mailer_templates_external_invite %}
external_invite = {{ mailer_templates_external_invite }}
{% endif %}
{% if mailer_templates_registered_event_update is defined and mailer_templates_registered_event_update %}
registered_event_update = {{ mailer_templates_registered_event_update }}
{% endif %}
{% if mailer_templates_unregistered_event_update is defined and mailer_templates_unregistered_event_update %}
unregistered_event_update  = {{ mailer_templates_unregistered_event_update }}
{% endif %}
{% if mailer_templates_external_event_update is defined and mailer_templates_external_event_update %}
external_event_update = {{ mailer_templates_external_event_update }}
{% endif %}
{% if mailer_templates_registered_event_cancellation is defined and mailer_templates_registered_event_cancellation %}
registered_event_cancellation = {{ mailer_templates_registered_event_cancellation }}
{% endif %}
{% if mailer_templates_unregistered_event_cancellation is defined and mailer_templates_unregistered_event_cancellation %}
unregistered_event_cancellation = {{ mailer_templates_unregistered_event_cancellation }}
{% endif %}
{% if mailer_templates_external_event_cancellation is defined and mailer_templates_external_event_cancellation %}
external_event_cancellation = {{ mailer_templates_external_event_cancellation }}
{% endif %}
{% if mailer_templates_registered_uninvite is defined and mailer_templates_registered_uninvite %}
registered_uninvite = {{ mailer_templates_registered_uninvite }}
{% endif %}
{% if mailer_templates_unregistered_uninvite is defined and mailer_templates_unregistered_uninvite %}
unregistered_uninvite = {{ mailer_templates_unregistered_uninvite }}
{% endif %}
{% if mailer_templates_external_uninvite is defined and mailer_templates_external_uninvite %}
external_uninvite = {{ mailer_templates_external_uninvite }}
{% endif %}

[frontend]
{% if mailer_frontend_base_url is defined and mailer_frontend_base_url %}
base_url = "{{ mailer_frontend_base_url }}"
{% endif %}
{% if mailer_frontend_data_protection_url is defined and mailer_frontend_data_protection_url %}
data_protection_url = "{{ mailer_frontend_data_protection_url }}"
{% endif %}

[languages]
default_language = "{{ mailer_languages_default_language }}"

{% if mailer_monitoring_addr is defined or mailer_monitoring_port is defined %}
[monitoring]
{% if mailer_monitoring_addr is defined and mailer_monitoring_addr %}
addr = "{{ mailer_monitoring_addr }}"
{% endif %}
{% if mailer_monitoring_port is defined and mailer_monitoring_port %}
port = {{ mailer_monitoring_port }}
{% endif %}
{% endif %}

{% if mailer_support_contact_phone is defined or mailer_support_contact_mail is defined %}
[support_contact]
{% if mailer_support_contact_phone is defined and mailer_support_contact_phone %}
phone = "{{ mailer_support_contact_phone }}"
{% endif %}
{% if mailer_support_contact_mail is defined and mailer_support_contact_mail %}
mail = "{{ mailer_support_contact_mail }}"
{% endif %}
{% endif %}