{% if Deployment.environment is defined and 'dev' in Deployment.environment %}
services:
  controller:
    extra_hosts:
      - "keycloak.localhost:host-gateway"
      - "etherpad.localhost:host-gateway"
      - "spacedeck.localhost:host-gateway"
    environment:
      RUST_LOG: debug
    labels: !override
      - "traefik.enable=true"
      - "traefik.http.routers.controller.rule=Host(`localhost`) && PathPrefix(`/controller`)"
      - "traefik.http.routers.controller.entrypoints=web"
      - "traefik.http.routers.controller.middlewares=controller-strip"
      - "traefik.http.middlewares.controller-strip.stripprefix.prefixes=/controller"
      - "traefik.http.services.controller.loadbalancer.server.port=11311"
{% else %}
services:
  controller:
{% if CustomCertificates.enabled is defined and CustomCertificates.enabled is true %}
    labels: !override
      - "traefik.enable=true"
      - "traefik.http.routers.controller.rule=Host(`${OT_DOMAIN}`) && PathPrefix(`/controller`)"
      - "traefik.http.routers.controller.entrypoints=websecure"
      - "traefik.http.routers.controller.middlewares=controller-strip"
      - "traefik.http.middlewares.controller-strip.stripprefix.prefixes=/controller"
      - "traefik.http.services.controller.loadbalancer.server.port=11311"
{% if CustomCA.enabled is defined and CustomCA.enabled is true %}
    volumes:
      - /opt/opentalk-compose{{ CustomCertificates.certs_dir }}/{{CustomCertificates.ssl_ca_file }}:/usr/local/share/ca-certificates/{{CustomCertificates.ssl_ca_file }}

    entrypoint: []
    command: >
       /bin/bash -c "update-ca-certificates; exec /controller/opentalk-controller"
    user: root
{% else %}
{% endif %}
{% endif %}
{% endif %}
