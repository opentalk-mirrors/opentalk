{% if controller_reports_template_inline is defined and controller_reports_template_inline %}
template.inline = """{{ controller_reports_template_inline }}"""
{% endif %}
{% if controller_reports_url is defined and controller_reports_url %}
url = "{{ controller_reports_url }}"
{% endif %}
{% endif %}

{% if controller_shared_folder_provider is defined %}
[shared_folder]
provider = "{{ controller_shared_folder_provider }}"
url = "{{ controller_shared_folder_url }}"
username = "{{ controller_shared_folder_username }}"
