disabled_features = [
{% for feature in controller_defaults_disabled_features %}
   "{{ feature }}"{% if not loop.last %},
{% endif %}
{% endfor %}
]
{% endif %}
{% endif %}

{% if controller_endpoints_disable_users_find is defined or
