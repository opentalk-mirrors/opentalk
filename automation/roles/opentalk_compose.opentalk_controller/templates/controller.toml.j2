# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

[frontend]
base_url = "{{ controller_frontend_base_url }}"

{% if controller_operator_information_data_protection_url is defined or
	controller_operator_information_support_phone_number is defined or
	controller_operator_information_support_email_address is defined %}
[operator_information]
{% if controller_operator_information_data_protection_url is defined and controller_operator_information_data_protection_url %}
data_protection_url = "{{ controller_operator_information_data_protection_url }}"
{% endif %}
{% if controller_operator_information_support_phone_number is defined and controller_operator_information_support_phone_number %}
#support_phone_number = "{{ controller_operator_information_support_phone_number }}"
{% endif %}
{% if controller_operator_information_support_email_address is defined and controller_operator_information_support_email_address %}
support_email_address = "{{ controller_operator_information_support_email_address }}"
{% endif %}
{% endif %}

[logging]
{% if controller_logging_default_directives is defined and controller_logging_default_directives %}
default_directives = [
{% for directive in controller_logging_default_directives %}
   "{{ directive }}"{% if not loop.last %},
{% endif %}
{% endfor %}
]
{% endif %}
{% if controller_logging_otlp_tracing_endpoint is defined and controller_logging_otlp_tracing_endpoint %}
otlp_tracing_endpoint = "{{ controller_logging_otlp_tracing_endpoint }}"
{% endif %}
{% if controller_logging_service_name is defined and controller_logging_service_name %}
service_name = "{{ controller_logging_service_name }}"
{% endif %}
{% if controller_logging_service_namespace is defined and controller_logging_service_namespace %}
service_namespace = "{{ controller_logging_service_namespace }}"
{% endif %}
{% if controller_logging_service_instance_id is defined and controller_logging_service_instance_id %}
service_instance_id = "{{ controller_logging_service_instance_id }}"
{% endif %}

[database]
{% if controller_database_user is defined and controller_database_user %}
url = "postgres://{{ controller_database_user }}:{{ controller_database_password }}@{{ controller_database_host }}:{{ controller_database_port }}/{{ controller_database_name }}"
{% else %}
url = "postgres://postgres:password123@localhost:5432/opentalk"
{% endif %}
{% if controller_database_max_connections is defined and controller_database_max_connections %}
max_connections = {{ controller_database_max_connections }}
{% endif %}

{% if controller_monitoring_addr is defined or controller_monitoring_port is defined %}
[monitoring]
{% if controller_monitoring_addr is defined and controller_monitoring_addr %}
addr = "{{ controller_monitoring_addr }}"
{% endif %}
{% if controller_monitoring_port is defined and controller_monitoring_port %}
port = {{ controller_monitoring_port }}
{% endif %}
{% endif %}

[http]
port = {{ controller_http_port | default('11311') }}
{% if controller_http_cors_allowed_origin is defined and controller_http_cors_allowed_origin %}
allowed_origin = {{ controller_http_cors_allowed_origin }}
{% endif %}

[oidc]
authority = "{{ controller_oidc_authority | default('https://example.com/auth/realms/OPENTALK') }}"

[oidc.frontend]
{% if controller_oidc_frontend_authority is defined and controller_oidc_frontend_authority %}
authority = "{{ controller_oidc_frontend_authority }}"
{% endif %}
client_id = "{{ controller_oidc_frontend_client_id | default('Frontend') }}"

[oidc.controller]
{% if controller_oidc_controller_authority is defined and controller_oidc_controller_authority %}
authority = "{{ controller_oidc_controller_authority }}"
{% endif %}
client_id = "{{ controller_oidc_controller_client_id }}"
client_secret = "{{ controller_oidc_controller_client_secret }}"

[user_search]
backend = "{{ controller_user_search_backend }}"
api_base_url = "{{ controller_user_search_api_base_url }}"
{% if controller_user_search_client_id is defined and controller_user_search_client_id %}
client_id = "{{ controller_user_search_client_id }}"
{% endif %}
{% if controller_user_search_client_secret is defined and controller_user_search_client_secret %}
client_secret = "{{ controller_user_search_client_secret }}"
{% endif %}
{% if controller_user_search_external_id_user_attribute_name is defined and controller_user_search_external_id_user_attribute_name %}
external_id_user_attribute_name = "{{ controller_user_search_external_id_user_attribute_name }}"
{% endif %}
users_find_behavior = "{{ controller_user_search_users_find_behavior }}"

[livekit]
public_url = "{{ controller_livekit_public_url }}"
service_url = "{{ controller_livekit_service_url }}"
api_key = "{{ controller_livekit_api_key }}"
api_secret = "{{ controller_livekit_api_secret }}"

[rabbit_mq]
{% if controller_rabbit_mq_url is defined and controller_rabbit_mq_url %}
url = "{{ controller_rabbit_mq_url }}"
{% endif %}
{% if controller_rabbit_mq_mail_task_queue is defined and controller_rabbit_mq_mail_task_queue %}
mail_task_queue = "{{ controller_rabbit_mq_mail_task_queue }}"
{% endif %}
{% if controller_rabbit_mq_recording_task_queue is defined and controller_rabbit_mq_recording_task_queue %}
recording_task_queue = "{{ controller_rabbit_mq_recording_task_queue }}"
{% endif %}
{% if controller_rabbit_mq_min_connections is defined and controller_rabbit_mq_min_connections %}
min_connections = "{{ controller_rabbit_mq_min_connections }}"
{% endif %}
{% if controller_rabbit_mq_max_channels_per_connection is defined and controller_rabbit_mq_max_channels_per_connection %}
max_channels_per_connection = "{{ controller_rabbit_mq_max_channels_per_connection }}"
{% endif %}

{% if controller_redis_url is defined and controller_redis_url %}
[redis]
url = "{{ controller_redis_url }}"
{% endif %}

{% if controller_authz_synchronize_controllers is defined and controller_authz_synchronize_controllers %}
[authz]
synchronize_controllers = {{ controller_authz_synchronize_controllers }}
{% endif %}

{% if controller_call_in_tel is defined or controller_call_in_enable_phone_mapping is defined or controller_call_in_default_country_code is defined %}
[call_in]
{% if controller_call_in_tel is defined and controller_call_in_tel %}
tel = "{{ controller_call_in_tel }}"
{% endif %}
{% if controller_call_in_enable_phone_mapping is defined %}
enable_phone_mapping = {{ controller_call_in_enable_phone_mapping | to_json }}
{% endif %}
{% if controller_call_in_default_country_code is defined and controller_call_in_default_country_code %}
default_country_code = "{{ controller_call_in_default_country_code }}"
{% endif %}
{% endif %}

[minio]
uri = "{{ controller_minio_uri }}"
bucket = "{{ controller_minio_bucket }}"
access_key = "{{ controller_minio_access_key }}"
secret_key = "{{ controller_minio_secret_key }}"

{% if controller_etcd_urls is defined and controller_etcd_urls %}
[etcd]
urls = [
{% for url in controller_etcd_urls %}
   "{{ url }}"{% if not loop.last %},
{% endif %}
{% endfor %}
]
{% endif %}

{% if controller_etherpad_url is defined and controller_etherpad_api_key is defined %}
[etherpad]
url = "{{ controller_etherpad_url }}"
api_key = "{{ controller_etherpad_api_key }}"
{% endif %}

{% if controller_spacedeck_url is defined and controller_spacedeck_api_key is defined %}
[spacedeck]
url = "{{ controller_spacedeck_url }}"
api_key = "{{ controller_spacedeck_api_key }}"
{% endif %}

{% if controller_reports_template_inline is defined or controller_reports_url is defined %}
