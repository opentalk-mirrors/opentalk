---
services:
  mailcrab:
    image: "{{ mailcrab_docker_image_src }}:{{ mailcrab_version }}"
    environment:
      MAILCRAB_PREFIX: "{{ mailcrab_webui_prefix }}"
    networks:
      - {{ docker_network_name }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.mailcrab.rule=Host(`{{ ot_domain }}`) && PathPrefix(`{{ mailcrab_webui_prefix }}`)"
      - "traefik.http.routers.mailcrab.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.mailcrab.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.routers.mailcrab.middlewares={{ mailcrab_docker_label_http_routers_minio_console_middlewares }}"
      - "traefik.http.services.mailcrab.loadbalancer.server.port=1080"
    healthcheck:
      test: wget --quiet --output-document=/dev/stdout http://127.0.0.1:1080{{ mailcrab_webui_prefix }}/api/version | grep -q version_be
      interval: 30s
      timeout: 15s
      retries: 3
      start_period: 15s
