services:
  garage:
    image: "{{ garage_docker_image_src }}:{{ garage_version }}"
    restart: always
    ports:
      - "{{ garage_bind_host }}:{{ garage_s3_api_port }}:3900"
{% if garage_rpc_port is defined and garage_rpc_port %}
      - "{{ garage_bind_host }}:{{ garage_rpc_port }}:3901"
{% endif %}
{% if garage_admin_api_port is defined and garage_admin_api_port %}
      - "{{ garage_bind_host }}:{{ garage_admin_api_port }}:3903"
{% endif %}
{% if garage_s3_web_port is defined and garage_s3_web_port %}
      - "{{ garage_bind_host }}:{{ garage_s3_web_port }}:3902"
{% endif %}
    networks:
      - {{ docker_network_name }}
    volumes:
      - garage_meta:{{ garage_metadata_dir }}
      - garage_data:{{ garage_data_dir }}
      - {{ garage_docker_compose_services_dir }}/garage/garage.toml:/etc/garage.toml:ro
    secrets:
      - garage_rpc_secret
      - garage_admin_token
    healthcheck:
      test: ["CMD", "/garage", "status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s


secrets:
  garage_rpc_secret:
    file: ${CONTAINER_SECRETS_PATH:-{{ config_dir }}/secrets}/.garage_rpc.secret
  garage_admin_token:
    file: ${CONTAINER_SECRETS_PATH:-{{ config_dir }}/secrets}/.garage_admin_token.secret

volumes:
  garage_meta:
  garage_data:
