---
services:
  ndt:
    image: "{{ ndt_docker_image_src }}:{{ ndt_version }}"
    ulimits:
      nofile:
        soft: {{ ndt_docker_compose_ulimits_nofile_soft }}
        hard: {{ ndt_docker_compose_ulimits_nofile_hard }}
      nproc: {{ ndt_docker_compose_ulimits_nproc }}
    networks:
      - {{ docker_network_name }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.ndt.rule=Host(`{{ ot_domain }}`) && PathPrefix(`/ndt`)"
      - "traefik.http.routers.ndt.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.ndt.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.ndt.loadbalancer.server.port=80"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8000/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
