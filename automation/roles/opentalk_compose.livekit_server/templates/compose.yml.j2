services:
  livekit-server:
    image: "{{ livekit_docker_image_src }}:{{ livekit_version }}"
    command: "--config /livekit.yaml"
    network_mode: host
    restart: always
    volumes:
      - ./config/livekit.yaml:/livekit.yaml
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.livekit.rule=Host(`{{ ot_domain }}`) && (PathPrefix(`/livekit`) || PathPrefix(`/twirp`))"
      - "traefik.http.routers.livekit.entrypoints={{ 'websecure' if traefik_letsencrypt_enable|default(false) or custom_certificates_enabled|default(false) else 'web' }}"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.livekit.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.routers.livekit.middlewares=livekit-strip"
      - "traefik.http.middlewares.livekit-strip.stripprefix.prefixes=/livekit"
      - "traefik.http.services.livekit.loadbalancer.server.port={{ livekit_port }}"
{% if livekit_turn_embedded_tls_enabled is defined and livekit_turn_embedded_tls_enabled %}
      - "traefik.tcp.routers.livekit-turn.rule=HostSNI(`{{ livekit_turn_embedded_domain }}`)"
      - "traefik.tcp.routers.livekit-turn.entrypoints=websecure"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.tcp.routers.livekit-turn.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.tcp.routers.livekit-turn.service=livekit-turn-service"
      - "traefik.tcp.services.livekit-turn-service.loadbalancer.server.port={{ livekit_turn_embedded_tls_port }}"
      - "traefik.tcp.routers.livekit-turn.priority=100"
{% endif %}
    healthcheck:
      test: wget --quiet --output-document=/dev/stdout http://localhost:{{ livekit_port}} | grep -q OK
      interval: 30s
      timeout: 15s
      retries: 3
      start_period: 15s
