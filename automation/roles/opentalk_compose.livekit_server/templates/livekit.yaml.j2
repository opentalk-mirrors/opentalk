# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.
---
# Reference: https://github.com/livekit/livekit/blob/master/config-sample.yaml

port: {{ livekit_port }}
rtc:
  tcp_port: {{ livekit_rtc_tcp_port }}
{% if livekit_rtc_port_range_start is defined and livekit_rtc_port_range_end is defined and (livekit_rtc_udp_port is not defined or not livekit_rtc_udp_port) %}
  port_range_start: {{ livekit_rtc_port_range_start }}
  port_range_end: {{ livekit_rtc_port_range_end }}
{% endif %}
{% if livekit_rtc_use_external_ip is defined and livekit_rtc_use_external_ip %}
  use_external_ip: {{ livekit_rtc_use_external_ip | to_json }}
{% endif %}
{% if livekit_rtc_enable_loopback_candidate is defined and livekit_rtc_enable_loopback_candidate %}
  enable_loopback_candidate: {{ livekit_rtc_enable_loopback_candidate | to_json }}
{% endif %}
{% if (livekit_rtc_node_ip is defined and livekit_rtc_node_ip) and (not livekit_rtc_use_external_ip) %}
  node_ip: {{ livekit_rtc_node_ip | default(ansible_host) }}
{% endif %}
{% if livekit_rtc_udp_port is defined and livekit_rtc_udp_port and (livekit_rtc_port_range_start is not defined or not livekit_rtc_port_range_start) and (livekit_rtc_port_range_end is not defined or not livekit_rtc_port_range_end) %}
  udp_port: {{ livekit_rtc_udp_port | default(livekit_rtc_tcp_port) }}
{% endif %}
{% if livekit_rtc_use_ice_lite is defined and livekit_rtc_use_ice_lite %}
  use_ice_lite: {{ livekit_rtc_use_ice_lite | to_json }}
{% endif %}
{% if (livekit_rtc_ips_excludes is defined and livekit_rtc_ips_excludes) or (livekit_rtc_ips_includes is defined and livekit_rtc_ips_includes) %}
  ips: 
{% if livekit_rtc_ips_includes is defined and livekit_rtc_ips_includes %}
    includes:
{% for ip in livekit_rtc_ips_includes %}
      - {{ ip }}
{% endfor %}
{% endif %}
{% if livekit_rtc_ips_excludes is defined and livekit_rtc_ips_excludes %}
    excludes:
{% for ip in livekit_rtc_ips_excludes %}
      - {{ ip }}
{% endfor %}
{% endif %}
{% endif %}
{% if livekit_rtc_stun_servers is defined and livekit_rtc_stun_servers %}
  stun_servers: 
{% for stun_server in livekit_rtc_stun_servers %}
    - {{ stun_server }}
{% endfor %}
{% endif %}
{% if livekit_rtc_turn_servers is defined and livekit_rtc_turn_servers %}
  turn_servers: 
{% for t in livekit_rtc_turn_servers %}
    - host: {{ t.host }}
      port: {{ t.port|default(3478) }}
      protocol: {{ t.protocol|default('udp') }}
{% if t.username is defined and t.username %}
      username: {{ t.username|default('') }}
{% endif %}
{% if t.credential is defined and t.credential %}
      credential: {{ t.credential|default('') }}
{% endif %}
{% endfor %}
{% endif %}

{% if livekit_turn_embedded_enabled is defined and livekit_turn_embedded_enabled %}
turn:
  domain: {{ livekit_turn_embedded_domain }}
  tls_port: {{ livekit_turn_embedded_tls_port }}
  udp_port: {{ livekit_turn_embedded_udp_port }}
  external_tls: {{ livekit_turn_embedded_external_tls | to_json}}
{% endif %}

{% if livekit_prometheus_port is defined and livekit_prometheus_port %}
prometheus_port: {{ livekit_prometheus_port }}
{% endif %}

{% if livekit_api_key_controller is defined and livekit_api_key_controller %}
keys:
  controller: {{ livekit_api_key_controller }}
{% endif %}

{% if livekit_logging is defined and livekit_logging %}
logging:
  {% if livekit_logging_json is defined and livekit_logging_json %}
  json: {{ livekit_logging_json }}
  {% endif %}
  {% if livekit_logging_level is defined and livekit_logging_level %}
  level: {{ livekit_logging_level }}
  {% endif %}
{% endif %}
