---
services:
  recorder:
    image: "{{ recorder_docker_image_src }}:{{ opentalk_recorder_version }}"
    ulimits:
      nofile:
        soft: {{ recorder_docker_compose_ulimits_nofile_soft }}
        hard: {{ recorder_docker_compose_ulimits_nofile_hard }}
      nproc: {{ recorder_docker_compose_ulimits_nproc }}
{% if recorder_docker_extra_hosts is defined and recorder_docker_extra_hosts %}
    extra_hosts:
{% for eh in recorder_docker_extra_hosts %}
      - "{{ eh }}"
{% endfor %}
{% endif %}
    restart: always
{% if recorder_docker_network_mode is defined and recorder_docker_network_mode %}
    network_mode: {{ recorder_docker_network_mode }}
{% endif %}
    environment:
      TZ: ${TZ:-Europe/Berlin}
      RUST_LOG: info,opentalk_recorder=debug,rustls=info,opentalk_recorder::signaling=debug
    volumes:
      - ./config/recorder.toml:/etc/opentalk/recorder.toml
{% if (custom_certificates_ca_root_cert_file is defined) and (custom_certificates_ca_root_cert_file | length > 0) %}
      - /etc/opentalk-compose/ssl/{{ custom_certificates_ca_root_cert_file }}:/usr/local/share/ca-certificates/{{ custom_certificates_ca_root_cert_file }}
{% endif %}
{% if (custom_certificates_ca_root_cert_file is defined) and (custom_certificates_ca_root_cert_file | length > 0) %}
    entrypoint: []
    command: >
       /bin/bash -c "update-ca-certificates; exec /recorder/opentalk-recorder"
    user: root
{% endif %}
{% if not (recorder_docker_network_mode is defined and recorder_docker_network_mode) %}
    networks:
      - {{ docker_network_name }}
{% endif %}
{% if recorder_hardware_acceleration_manufacturer is defined
   and recorder_hardware_acceleration_manufacturer == 'intel'
   and recorder_hardware_acceleration_device is defined %}
    # Intel VAAPI Hardware Acceleration
    devices:
      - "/dev/dri:/dev/dri"
    group_add:
      - "video"
    cap_add:
      - CAP_PERFMON
{% endif %}
    healthcheck:
      test:
      - "CMD-SHELL"
      - |
        perl -MIO::Socket::INET -e 'my $$sock = IO::Socket::INET->new(PeerAddr => "localhost:11411", Proto => "tcp") or exit 1; 
        print $$sock "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"; my $$response = <$$sock>; exit ($$response =~ /200 OK/ ? 0 : 1);'
