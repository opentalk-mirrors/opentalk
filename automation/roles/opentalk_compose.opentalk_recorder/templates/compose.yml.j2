services:
  recorder:
    image: "{{ recorder_docker_image_src }}:{{ opentalk_recorder_version }}"
{% if recorder_docker_extra_hosts is defined and recorder_docker_extra_hosts %}
    extra_hosts:
{% for eh in recorder_docker_extra_hosts %}
      - "{{ eh }}"
{% endfor %}
{% endif %}
    restart: always
    environment:
      TZ: ${TZ:-Europe/Berlin}
      RUST_LOG: info,opentalk_recorder=debug,rustls=info,opentalk_recorder::signaling=debug
{% if custom_certificates_enabled is defined and custom_certificates_enabled is true %}
{% elif custom_ca_enabled is defined and custom_ca_enabled is true %}
    volumes:
      - ./config/recorder.toml:/etc/opentalk/recorder.toml
      - /opt/opentalk-compose{{ custom_certificates_certs_dir }}/{{ custom_certificates_ssl_ca_file }}:/usr/local/share/ca-certificates/{{ custom_certificates_ssl_ca_file }}
    entrypoint: []
    command: >
       /bin/bash -c "update-ca-certificates; exec /recorder/opentalk-recorder"
    user: root
{% else %}
    volumes:
      - ./config/recorder.toml:/etc/opentalk/recorder.toml
{% endif %}
    networks:
      - {{ docker_network_name }}
{% if recorder_hardware_acceleration_manufacturer is defined
   and recorder_hardware_acceleration_manufacturer == 'intel'
   and recorder_hardware_acceleration_device is defined %}
    # Intel VAAPI Hardware Acceleration
    devices:
      - "/dev/dri:/dev/dri"
    group_add:
      - "video"
{% endif %}
    healthcheck:
      test:
      - "CMD-SHELL"
      - |
        perl -MIO::Socket::INET -e 'my $$sock = IO::Socket::INET->new(PeerAddr => "localhost:11411", Proto => "tcp") or exit 1; 
        print $$sock "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"; my $$response = <$$sock>; exit ($$response =~ /200 OK/ ? 0 : 1);'

networks:
  {{ docker_network_name }}:
    external: true
