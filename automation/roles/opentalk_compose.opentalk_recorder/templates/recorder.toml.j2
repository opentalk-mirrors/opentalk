# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

[auth]
issuer = "{{ recorder_auth_issuer }}"
client_id = "{{ recorder_auth_client_id }}"
client_secret = "{{ recorder_auth_client_secret }}"

[controller]
domain = "{{ recorder_controller_domain }}"

{% if recorder_controller_insecure is defined and recorder_controller_insecure %}
insecure = {{ recorder_controller_insecure }}
{% endif %}

[rabbitmq]
uri = "{{ recorder_rabbitmq_uri }}"
queue = "{{ recorder_rabbitmq_queue }}"

[recorder]
display = {{ recorder_recorder_display }}
clock_format = "{{ recorder_recorder_clock_format }}"

{% if recorder_hardware_acceleration_manufacturer is defined and recorder_hardware_acceleration_device is defined %}
[recorder.hardware_acceleration]
manufacturer = "{{ recorder_hardware_acceleration_manufacturer }}"
device = "{{ recorder_hardware_acceleration_device }}"
{% endif %}

{% if recorder_monitoring_port is defined %}
[monitoring]
port = {{ recorder_monitoring_port }}
{% endif %}
