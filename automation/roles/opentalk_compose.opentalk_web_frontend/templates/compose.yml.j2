---
services:
  web-frontend:
    image: "{{ opentalk_web_frontend_docker_image_src }}:{{ opentalk_web_frontend_version }}"
    ulimits:
      nofile:
          soft: {{ opentalk_web_frontend_docker_compose_ulimits_nofile_soft }}
          hard: {{ opentalk_web_frontend_docker_compose_ulimits_nofile_hard }}
      nproc: {{ opentalk_web_frontend_docker_compose_ulimits_nproc }}
{% if opentalk_web_frontend_docker_extra_hosts is defined and opentalk_web_frontend_docker_extra_hosts %}
    extra_hosts:
{% for eh in opentalk_web_frontend_docker_extra_hosts %}
      - "{{ eh }}"
{% endfor %}
{% endif %}
    restart: always
    networks:
      -  {{ docker_network_name }}
    environment:
      INSECURE: {{ opentalk_web_frontend_environment_insecure | to_json }}
      CONTROLLER_HOST: {{ opentalk_web_frontend_environment_controller_host }}
      BASE_URL: {{ opentalk_web_frontend_environment_base_url }}
      OIDC_ISSUER: {{ opentalk_web_frontend_environment_oidc_issuer }}
      OIDC_CLIENT_ID: {{ opentalk_web_frontend_environment_oidc_client_id }}
      LIVEKIT_SERVER_URL: {{ opentalk_web_frontend_environment_livekit_server_url }}
      NDT_SERVER: {{ opentalk_web_frontend_environment_ndt_server }}
      CHANGE_PASSWORD_URL: {{ opentalk_web_frontend_environment_change_password_url }}
      ERROR_REPORT_ADDRESS: {{ opentalk_web_frontend_environment_error_report_address }}
      LIBRAVATAR_DEFAULT_IMAGE: {{ opentalk_web_frontend_environment_libravatar_default_image }}
      VIDEO_BACKGROUNDS: >-
        {{ opentalk_web_frontend_environment_video_backgrounds | indent(8) }}
      IS_BETA_RELEASE: {{ opentalk_web_frontend_environment_is_beta_release | to_json }}
      FEATURE_USER_SEARCH: {{ opentalk_web_frontend_environment_feature_user_search | to_json }}
      FEATURE_TIMER: {{ opentalk_web_frontend_environment_feature_timer | to_json }}
      FEATURE_WHITEBOARD: {{ opentalk_web_frontend_environment_feature_whiteboard | to_json }}
      FEATURE_PROTOCOL: {{ opentalk_web_frontend_environment_feature_protocol | to_json }}
      FEATURE_RECORDING: {{ opentalk_web_frontend_environment_feature_recording | to_json }}
      WAITING_ROOM_DEFAULT_VALUE: {{ opentalk_web_frontend_environment_waiting_room_default_value }}
      SUPPRESS_BROWSER_COMPATIBILITY_INFO: {{ opentalk_web_frontend_environment_suppress_browser_compatibility_info | to_json }}
{% if opentalk_web_frontend_environment_feature_e2e_encryption is defined and opentalk_web_frontend_environment_feature_e2e_encryption | bool %}
      FEATURE_E2E_ENCRYPTION: {{ opentalk_web_frontend_environment_feature_e2e_encryption | to_json }}
      LIVEKIT_E2EE_SALT: {{ opentalk_web_frontend_environment_livekit_e2ee_salt }}
{% endif %}
      LIVEKIT_PREFERRED_VIDEO_CODEC: {{ opentalk_web_frontend_environment_livekit_preferred_video_codec }}
      PRODUCT_VERSION: {{ opentalk_product_version }}
    labels:
      - "traefik.enable={{ opentalk_web_frontend_labels_traefik_enable | to_json }}"
      - "traefik.http.routers.webapp.rule=Host(`{{ ot_domain }}`)"
      - "traefik.http.routers.webapp.priority=10" 
      - "traefik.http.routers.webapp.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.webapp.middlewares=secure-headers@file"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.webapp.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.webapp.loadbalancer.server.port=80"
      - "traefik.http.routers.webapp-callback.rule=Host(`{{ ot_domain }}`) && Path(`/auth/callback`)"
      - "traefik.http.routers.webapp-callback.priority=100"
      - "traefik.http.routers.webapp-callback.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.webapp-callback.middlewares=secure-headers@file"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.webapp-callback.tls.certresolver=letsencrypt"
{% endif %}

# CORS headers
      - "traefik.http.routers.webapp-callback.middlewares=webapp-cors"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowMethods=GET,POST,PUT,DELETE,OPTIONS"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowOriginList={{ opentalk_web_frontend_labels_traefik_http_middlewares_webapp_cors_headers_accessControlAllowOriginList }}"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowCredentials=true"
      - "traefik.http.middlewares.webapp-cors.headers.accessControlAllowHeaders=Content-Type,Authorization"

    healthcheck:
      test: wget -nv -t1 --spider http://localhost:80 || exit 1
      interval: 30s
      timeout: 15s
      retries: 3
      start_period: 15s
