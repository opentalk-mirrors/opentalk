# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

[controller]
{% if recorder_controller_url is defined and recorder_controller_url %}
url = "{{ recorder_controller_url }}"
{% elif recorder_controller_domain is defined and recorder_controller_domain %}
url = "http://{{ recorder_controller_domain }}"
{% endif %}
{% if recorder_controller_api_key_id is defined and recorder_controller_api_key_secret is defined %}
api_key = { id = "{{ recorder_controller_api_key_id }}", secret = "{{ recorder_controller_api_key_secret }}" }
{% endif %}

{% if recorder_orchestrator_url is defined and recorder_orchestrator_url %}
[orchestrator]
{% if recorder_orchestrator_api_key_id is defined and recorder_orchestrator_api_key_secret is defined %}
api_key = { id = "{{ recorder_orchestrator_api_key_id }}", secret = "{{ recorder_orchestrator_api_key_secret }}" }
{% endif %}
url = "{{ recorder_orchestrator_url }}"
{% endif %}

[http]
host = "{{ recorder_http_host | default('0.0.0.0') }}"
port = "{{ recorder_http_port | default('5555') }}"
{% if recorder_http_api_keys is defined %}
api_keys = [{% for key in recorder_http_api_keys %}{ id = "{{ key.id }}", secret = "{{ key.secret }}" }{% if not loop.last %}, {% endif %}{% endfor %}]
{% elif recorder_controller_api_key_id is defined and recorder_controller_api_key_secret is defined %}
api_keys = [{ id = "{{ recorder_controller_api_key_id }}", secret = "{{ recorder_controller_api_key_secret }}" }]
{% else %}
api_keys = []
{% endif %}

[recorder]
display = {{ recorder_recorder_display }}
clock_format = "{{ recorder_recorder_clock_format }}"

{% if recorder_hardware_acceleration_manufacturer is defined and recorder_hardware_acceleration_device is defined %}
[recorder.hardware_acceleration]
manufacturer = "{{ recorder_hardware_acceleration_manufacturer }}"
device = "{{ recorder_hardware_acceleration_device }}"
{% endif %}

{% if recorder_monitoring_port is defined %}
[monitoring]
port = {{ recorder_monitoring_port }}
{% endif %}
