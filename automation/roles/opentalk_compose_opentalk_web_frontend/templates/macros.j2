{% macro url(protocol, domain, port='') -%}
{{ protocol }}://{{ domain }}{{ (':' ~ port) if port|default('') and (port|string not in ['80','443']) else '' }}
{%- endmacro %}

{% macro host(domain, port='') -%}
{{ domain }}{{ (':' ~ port) if port|default('') else '' }}
{%- endmacro %}