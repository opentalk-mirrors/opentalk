# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

global:
  checkNewVersion: {{ traefik_global_checkNewVersion | to_json}}
  sendAnonymousUsage: {{ traefik_global_sendAnonymousUsage | to_json}}

log:
  level: {{ traefik_log_level }}

accessLog:
  bufferingSize: {{ traefik_accessLog_bufferingSize }}

api:
  dashboard: {{ traefik_api_dashboard | to_json }}
  insecure: {{ traefik_api_insecure | to_json }}

entryPoints:
  web:
    address: "{{ traefik_entryPoints_web_address }}"
{% if (custom_certificates_enabled is defined and custom_certificates_enabled is true) or (traefik_letsencrypt_enable is defined and traefik_letsencrypt_enable is true) %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
{% endif %}
  websecure:
    address: "{{ traefik_entryPoints_websecure_address }}"
{% if custom_certificates_enabled is defined and custom_certificates_enabled is true %}
    http:
      tls: {{ traefik_entryPoints_websecure_http_tls }}
{% endif %}
  ping:
    address: "{{ traefik_entryPoints_ping_address }}"

ping:
  entryPoint: "{{ traefik_ping_entryPoint }}"

{% if (traefik_letsencrypt_enable is defined and traefik_letsencrypt_enable is true) and (custom_certificates_enabled is not defined or custom_certificates_enabled is false) %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ traefik_letsencrypt_acme_email }}
      storage: {{ traefik_letsencrypt_acme_storage }}
      caServer: {{ traefik_letsencrypt_acme_caServer }}
      httpChallenge:
        entryPoint: {{ traefik_letsencrypt_acme_httpChallenge_entryPoint }}
{% endif %}

providers:
  docker:
    exposedByDefault: {{ traefik_providers_docker_exposedByDefault | to_json }}
    network: {{ docker_network_name }}
  file:
    directory: {{ traefik_providers_file_directory }}
    watch: {{ traefik_providers_file_watch | to_json }}