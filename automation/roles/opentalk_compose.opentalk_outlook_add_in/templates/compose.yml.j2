services:
  outlook_add_in:
    image: {{ outlook_add_in_docker_image_src }}:{{ opentalk_outlook_add_in_version }}
    restart: always
    environment:
      OPENTALK_OUTLOOK_URL: "{{ outlook_add_in_outlook_url }}"
      OPENTALK_OUTLOOK_WEBAPP_URL: "{{ outlook_add_in_outlook_webapp_url }}"
      OPENTALK_OUTLOOK_OIDC_CLIENT_ID: "{{ outlook_add_in_oidc_client_id }}"
    networks:
      - {{ docker_network_name }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.outlook_add_in.rule=Host(`{{ ot_domain }}`) && PathPrefix(`/outlook`)"
      - "traefik.http.routers.outlook_add_in.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.outlook_add_in.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.routers.outlook_add_in.priority=100"
      - "traefik.http.services.outlook_add_in.loadbalancer.server.port=80"
      # Path rewrite: /outlook/(.*) -> /$1
      - "traefik.http.middlewares.outlook_add_in-rewrite.replacePathRegex.regex=^/outlook/(.*)"
      - "traefik.http.middlewares.outlook_add_in-rewrite.replacePathRegex.replacement=/$1"
      - "traefik.http.routers.outlook_add_in.middlewares=outlook_add_in-rewrite@docker,outlook_add_in-cors@docker"
      # CORS Middleware
      - "traefik.http.middlewares.outlook_add_in-cors.headers.accessControlAllowOriginList={{ outlook_add_in_labels_traefik_http_middlewares_outlook_add_in_cors_headers_accessControlAllowOriginList }}"
      - "traefik.http.middlewares.outlook_add_in-cors.headers.accessControlAllowMethods=GET,OPTIONS,PUT,POST,DELETE,PATCH"
      - "traefik.http.middlewares.outlook_add_in-cors.headers.accessControlAllowHeaders=Content-Type,Authorization,X-Requested-With"
      - "traefik.http.middlewares.outlook_add_in-cors.headers.addVaryHeader=true"
