services:
  etherpad:
    image: "{{ etherpad_docker_image_src }}:{{ etherpad_version }}"
    ulimits:
      nofile:
        soft: {{ etherpad_docker_compose_ulimits_nofile_soft }}
        hard: {{ etherpad_docker_compose_ulimits_nofile_hard }}
      nproc: {{ etherpad_docker_compose_ulimits_nproc }}
{% if etherpad_docker_extra_hosts is defined and etherpad_docker_extra_hosts %}
    extra_hosts:
{% for eh in etherpad_docker_extra_hosts %}
      - "{{ eh }}"
{% endfor %}
{% endif %}
{% if etherpad_docker_ports is defined and etherpad_docker_ports %}
    ports:
{% for port in etherpad_docker_ports %}
      - "{{ port }}"
{% endfor %}
{% endif %}
    restart: always
    networks:
      -  {{ docker_network_name }}
    environment:
      TRUST_PROXY: {{ etherpad_docker_environment_trust_proxy | to_json }}
      DEFAULT_PAD_TEXT: {{ etherpad_docker_environment_default_pad_text }}
      SUPPRESS_ERRORS_IN_PAD_TEXT: {{ etherpad_docker_environment_suppress_errors_in_pad_text | to_json }}
    secrets:
      - source: etherpad_api_secret
        target: /opt/etherpad-lite/APIKEY.txt
    entrypoint: ["pnpm", "run", "prod"]
    user: root
    labels:
      - "traefik.enable={{ etherpad_docker_labels_traefik_enable | to_json }}"
      - "traefik.http.routers.etherpad.rule={{ etherpad_docker_labels_traefik_http_routers_etherpad_rule}}"
      - "traefik.http.routers.etherpad.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-api.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathPrefix(`/api/1`)"
      - "traefik.http.routers.etherpad-api.priority=120"
      - "traefik.http.routers.etherpad-api.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-api.service=etherpad"
      - "traefik.http.routers.etherpad-auth.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/auth_session`)"
      - "traefik.http.routers.etherpad-auth.priority=120"
      - "traefik.http.routers.etherpad-auth.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-auth.service=etherpad"
      - "traefik.http.routers.etherpad-pad.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathPrefix(`/p/`)"
      - "traefik.http.routers.etherpad-pad.priority=120"
      - "traefik.http.routers.etherpad-pad.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-pad.service=etherpad"
      - "traefik.http.routers.etherpad-static-skins.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathPrefix(`/static/skins/`)"
      - "traefik.http.routers.etherpad-static-skins.priority=120"
      - "traefik.http.routers.etherpad-static-skins.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-static-skins.service=etherpad"
      - "traefik.http.routers.etherpad-static-padcss.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/static/css/pad.css`)"
      - "traefik.http.routers.etherpad-static-padcss.priority=120"
      - "traefik.http.routers.etherpad-static-padcss.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-static-padcss.service=etherpad"
      - "traefik.http.routers.etherpad-static-iframecss.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/static/css/iframe_editor.css`)"
      - "traefik.http.routers.etherpad-static-iframecss.priority=120"
      - "traefik.http.routers.etherpad-static-iframecss.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-static-iframecss.service=etherpad"
      - "traefik.http.routers.etherpad-static-padjs.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/static/js/pad.js`)"
      - "traefik.http.routers.etherpad-static-padjs.priority=120"
      - "traefik.http.routers.etherpad-static-padjs.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-static-padjs.service=etherpad"
      - "traefik.http.routers.etherpad-static-empty.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/static/empty.html`)"
      - "traefik.http.routers.etherpad-static-empty.priority=120"
      - "traefik.http.routers.etherpad-static-empty.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-static-empty.service=etherpad"
      - "traefik.http.routers.etherpad-padbootstrap.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathPrefix(`/padbootstrap-`)"
      - "traefik.http.routers.etherpad-padbootstrap.priority=120"
      - "traefik.http.routers.etherpad-padbootstrap.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-padbootstrap.service=etherpad"
      - "traefik.http.routers.etherpad-locales.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/locales.json`)"
      - "traefik.http.routers.etherpad-locales.priority=120"
      - "traefik.http.routers.etherpad-locales.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-locales.service=etherpad"
      - "traefik.http.routers.etherpad-locales-files.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathRegexp(`^/locales/.+\\.json$`)"
      - "traefik.http.routers.etherpad-locales-files.priority=120"
      - "traefik.http.routers.etherpad-locales-files.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-locales-files.service=etherpad"
      - "traefik.http.routers.etherpad-pluginfw.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathPrefix(`/pluginfw/`)"
      - "traefik.http.routers.etherpad-pluginfw.priority=120"
      - "traefik.http.routers.etherpad-pluginfw.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-pluginfw.service=etherpad"
      - "traefik.http.routers.etherpad-socketio.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && PathPrefix(`/socket.io/`)"
      - "traefik.http.routers.etherpad-socketio.priority=120"
      - "traefik.http.routers.etherpad-socketio.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-socketio.service=etherpad"
      - "traefik.http.routers.etherpad-jserror.rule=Host(`{{ etherpad_docker_labels_traefik_host | default(ot_domain) }}`) && Path(`/jserror`)"
      - "traefik.http.routers.etherpad-jserror.priority=120"
      - "traefik.http.routers.etherpad-jserror.entrypoints={{ 'websecure' if traefik_letsencrypt_enable or custom_certificates_enabled else 'web' }}"
      - "traefik.http.routers.etherpad-jserror.service=etherpad"
{% if (traefik_letsencrypt_enable | default('true')) and (not custom_certificates_enabled is defined or not custom_certificates_enabled) %}
      - "traefik.http.routers.etherpad.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-api.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-auth.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-pad.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-static-skins.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-static-padcss.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-static-iframecss.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-static-padjs.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-static-empty.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-padbootstrap.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-locales.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-locales-files.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-pluginfw.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-socketio.tls.certresolver=letsencrypt"
      - "traefik.http.routers.etherpad-jserror.tls.certresolver=letsencrypt"
{% endif %} 
      - "traefik.http.routers.etherpad.priority=100"
      - "traefik.http.routers.etherpad.middlewares=etherpad-strip"
      - "traefik.http.middlewares.etherpad-strip.stripprefix.prefixes=/etherpad"
      - "traefik.http.services.etherpad.loadbalancer.server.port=9001"

secrets:
  etherpad_api_secret:
    file: ${CONTAINER_SECRETS_PATH:-{{ config_dir }}/secrets}/.etherpad_api.secret

