[http]
address = "{{ orchestrator_http_address }}"
port = {{ orchestrator_http_port }}
public_url = "{{ orchestrator_public_url }}"
api_keys = [{ id = "{{ orchestrator_api_key_id }}", secret = "{{ ORCHESTRATOR_API_SECRET }}" }]

[services]
keys = [{ id = "{{ orchestrator_services_key_id }}", secret = "{{ ROOMSERVER_API_SECRET }}" }]

[storage]
# The storage backend used to keep track of registered service instances.
kind = "{{ orchestrator_storage_kind }}"
{% if orchestrator_storage_redis_url is defined %}
url = "{{ orchestrator_storage_redis_url }}"
{% endif %}
