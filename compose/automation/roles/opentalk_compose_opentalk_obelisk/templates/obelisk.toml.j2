# !!! DO NOT EDIT THIS FILE BY HAND !!!
# This configuration file is managed by ansible. Changes will be overwritten.

clock_format = "{{ obelisk_clock_format }}"
{% if obelisk_language is defined and obelisk_language %}
language = "{{ obelisk_language }}"
{% endif %}

[controller]
{% if obelisk_controller_domain is defined and obelisk_controller_domain %}
url = "{{ 'http' if obelisk_controller_insecure else 'https' }}://{{ obelisk_controller_domain }}/"
{% else %}
url = "{{ obelisk_controller_url }}"
{% endif %}
api_key = { id = "{{ obelisk_controller_api_key_id }}", secret = "{{ obelisk_controller_api_key_secret }}" }

[sip]
addr = "{{ obelisk_sip_addr }}"
port = {{ obelisk_sip_port }}
{% if obelisk_sip_transport is defined and obelisk_sip_transport %}
transport = "{{ obelisk_sip_transport }}"
{% endif %}
{% if obelisk_sip_id is defined and obelisk_sip_id %}
id = "{{ obelisk_sip_id }}"
{% endif %}
{% if obelisk_sip_contact is defined and obelisk_sip_contact %}
contact = "{{ obelisk_sip_contact }}"
{% endif %}
{% if obelisk_sip_inbound_addr is defined and obelisk_sip_inbound_addr %}
inbound_addr = "{{ obelisk_sip_inbound_addr }}"
{% endif %}
{% if obelisk_sip_inbound_media_ip is defined and obelisk_sip_inbound_media_ip %}
inbound_media_ip = "{{ obelisk_sip_inbound_media_ip }}"
{% endif %}
{% if obelisk_sip_username is defined and obelisk_sip_username %}
username = "{{ obelisk_sip_username }}"
{% endif %}
{% if obelisk_sip_password is defined and obelisk_sip_password %}
password = "{{ obelisk_sip_password }}"
{% endif %}
{% if obelisk_sip_realm is defined and obelisk_sip_realm %}
realm = "{{ obelisk_sip_realm }}"
{% endif %}
{% if obelisk_sip_registrar is defined and obelisk_sip_registrar %}
registrar = "{{ obelisk_sip_registrar }}"
{% endif %}
{% if obelisk_sip_outbound_proxy is defined and obelisk_sip_outbound_proxy %}
outbound_proxy = "{{ obelisk_sip_outbound_proxy }}"
{% endif %}
{% if obelisk_sip_nat_ping_delta is defined and obelisk_sip_nat_ping_delta %}
nat_ping_delta = "{{ obelisk_sip_nat_ping_delta }}"
{% endif %}
{% if obelisk_sip_stun_server is defined and obelisk_sip_stun_server %}
stun_server = "{{ obelisk_sip_stun_server }}"
{% endif %}
enforce_qop = {{ obelisk_sip_enforce_qop | to_json }}
{% if obelisk_sip_max_audio_bitrate is defined and obelisk_sip_max_audio_bitrate %}
max_audio_bitrate = "{{ obelisk_sip_max_audio_bitrate }}"
{% endif %}
{% if obelisk_sip_max_video_bitrate is defined and obelisk_sip_max_video_bitrate %}
max_video_bitrate = {{ obelisk_sip_max_video_bitrate }}
{% endif %}
{% if obelisk_sip_encode_video_at_half_bitrate is defined and obelisk_sip_encode_video_at_half_bitrate != '' %}
encode_video_at_half_bitrate = {{ obelisk_sip_encode_video_at_half_bitrate | to_json }}
{% endif %}
{% if obelisk_sip_display_name_source is defined and obelisk_sip_display_name_source %}
display_name_source = "{{ obelisk_sip_display_name_source }}"
{% endif %}
{% if obelisk_sip_offer_srtp is defined and obelisk_sip_offer_srtp != '' %}
offer_srtp = {{ obelisk_sip_offer_srtp | to_json }}
{% endif %}

[sip.rtp_port_range]
start = {{ obelisk_sip_rtp_port_range_start }}
end = {{ obelisk_sip_rtp_port_range_end }}

{% if obelisk_monitoring_enable is defined and obelisk_monitoring_enable %}
[monitoring]
{% if obelisk_monitoring_addr is defined and obelisk_monitoring_addr %}
addr = "{{ obelisk_monitoring_addr }}"
{% endif %}
{% if obelisk_monitoring_port is defined and obelisk_monitoring_port %}
port = {{ obelisk_monitoring_port }}
{% endif %}
{% endif %}
