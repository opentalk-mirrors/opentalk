{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pip_requirements": {
    "fileMatch": ["^extras/packaging/requirements-ansible\\.in$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^extras/packaging/uv\\.version$"],
      "matchStrings": [
        "UV_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
