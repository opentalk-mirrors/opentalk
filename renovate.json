{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pre-commit": {
    "enabled": true
  },
  "configMigration": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "glib",
        "gst*",
        "gstreamer-*",
        "gstreamer"
      ],
      "groupName": "gstreamer",
      "groupSlug": "gstreamer"
    },
    {
      "matchPackageNames": [
        "typst-*"
      ],
      "groupName": "typst",
      "groupSlug": "typst"
    },
    {
      "groupName": "EZK-rs",
      "groupSlug": "EZK-rs",
      "matchPackageNames": [
        "/ezk-*/"
      ]
    },
    {
      "groupName": "vergen",
      "groupSlug": "vergen",
      "matchPackageNames": [
        "/^vergen*/"
      ]
    },
    {
      "matchPackageNames": [
        "egui*",
        "eframe"
      ],
      "groupName": "egui",
      "groupSlug": "egui"
    },
    {
      "matchPackageNames": [
        "tungstenite",
        "tokio-tungstenite"
      ],
      "groupName": "tungstenite",
      "groupSlug": "tungstenite"
    },
    {
      "groupName": "chrono-tz",
      "groupSlug": "chrono-tz",
      "matchPackageNames": [
        "/chrono-tz/",
        "/ics-chrono-tz/"
      ]
    },
    {
      "matchPackageNames": [
        "/opentelemetry/"
      ],
      "groupName": "opentelemetry-rs",
      "groupSlug": "opentelemetry-rs"
    },
    {
      "matchPackageNames": [
        "/^livekit/"
      ],
      "groupName": "livekit",
      "groupSlug": "livekit"
    },
    {
      "matchPackageNames": [
        "/^testcontainers/"
      ],
      "groupName": "testcontainers",
      "groupSlug": "testcontainers"
    },
    {
      "matchPackageNames": [
        "/^refinery/"
      ],
      "groupName": "refinery",
      "groupSlug": "refinery"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["redocly/cli"],
      "extends": ["schedule:monthly"]
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit",
      "extends": ["schedule:weekly"]
    }
  ]
}
